/patronus-web
/patronus-cni
/patronus-bench

# Temporary files
*.tmp
tmp/

# Node (frontend/)
node_modules/
frontend/dist/
frontend/.vite/
/static/
__pycache__/

# Dashboard JWT signing secret generated on first start (never commit)
jwt_secret

# generated by generate-ha-certs.sh (private key!)
/certs/
.mutation-baseline/

# live ISO builder outputs
gentoo/iso/
iso-out/

# site build inputs/outputs
site/dist/
site/THIRD-PARTY-LICENSES.txt
THIRD-PARTY-LICENSES.txt
THIRD-PARTY-LICENSES.txt.gz

# release tarballs and ISOs are release assets, never tracked (every CI checkout downloads the whole tree)
/releases/*.tar.gz
/releases/*.sha256
/output/

