#!/bin/sh
# Unattended install of the live image to $1 with the project's own installer.
disk=$1
[ -d /sys/firmware/efi ] && scheme=uefi-simple || scheme=bios-simple
cat > /tmp/autoinstall.toml <<CFG
target_root = "/mnt/install"
[disk]
device = "$disk"
scheme = "$scheme"
filesystem = "ext4"
swap_size_mb = 0
[system]
hostname = "patronus"
timezone = "UTC"
locale = "en_US.UTF-8"
keyboard = "us"
bootloader = "grub"
[network]
interfaces = []
[services]
CFG
exec /usr/bin/patronus-install --config /tmp/autoinstall.toml --yes
