# Boot-time apply of the whole stored configuration (the service name is
# kept for compatibility). `patronus apply` opens
# /var/lib/patronus/config.db, seeds the safe default ruleset on first boot
# ([network] in /etc/patronus/patronus.toml names the WAN/LAN interfaces),
# then applies sysctl -> interfaces/VLANs -> routes -> firewall/NAT ->
# services. `patronus firewall apply` is the firewall-only subset.

description="Patronus boot apply (sysctl, interfaces, routes, firewall/NAT, services)"
extra_started_commands="reload"

depend() {
	need localmount
	before net
	provide firewall
}

start() {
	ebegin "Applying Patronus configuration"
	/usr/bin/patronus apply
	eend $?
}

stop() {
	ebegin "Flushing Patronus firewall rules"
	/usr/bin/patronus firewall flush
	eend $?
}

reload() {
	ebegin "Re-applying Patronus configuration"
	/usr/bin/patronus apply
	eend $?
}
