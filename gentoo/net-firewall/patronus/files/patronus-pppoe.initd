#!/sbin/openrc-run
# Copyright 2026 Gentoo Authors
# Distributed under the terms of the GNU General Public License v3

# Multiplexed: /etc/init.d/patronus-pppoe.<link> -> patronus-pppoe (USE=pppoe).
# `patronus apply` creates the symlink and starts/stops the instance; pppd's
# options (credentials, mode 0600) are generated from the config store into
# /var/lib/patronus/net/ppp/<link>.options.

LINK="${RC_SVCNAME#*.}"
ENVFILE="/var/lib/patronus/net/svc/patronus-pppoe.${LINK}.env"
description="Patronus PPPoE link ${LINK}"
supervisor=supervise-daemon
respawn_delay=5
pidfile="/run/${RC_SVCNAME}.pid"

depend() {
	need localmount
}

start_pre() {
	if [ "${LINK}" = "${RC_SVCNAME}" ]; then
		eerror "Use the per-link instance (patronus-pppoe.<link>)"
		return 1
	fi
	[ -r "${ENVFILE}" ] || { eerror "${ENVFILE} is missing (run 'patronus apply')"; return 1; }
	. "${ENVFILE}"
	set -- ${PATRONUS_CMD}
	command="$1"
	shift
	command_args="$*"
}
