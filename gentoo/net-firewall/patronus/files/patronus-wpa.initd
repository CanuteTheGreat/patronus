#!/sbin/openrc-run
# Copyright 2026 Gentoo Authors
# Distributed under the terms of the GNU General Public License v3

# Multiplexed: /etc/init.d/patronus-wpa.<device> -> patronus-wpa.
# `patronus apply` creates the symlink and starts/stops the instance for every
# enabled Wi-Fi uplink (USE=wifi-client: the device joins an upstream access
# point as a WAN); the command line and its config (mode 0600) are generated
# from the config store into /var/lib/patronus/net. Do not add it to a runlevel
# by hand.

DEV="${RC_SVCNAME#*.}"
ENVFILE="/var/lib/patronus/net/svc/patronus-wpa.${DEV}.env"
description="Patronus Wi-Fi uplink (wpa_supplicant) on ${DEV}"
supervisor=supervise-daemon
respawn_delay=3
pidfile="/run/${RC_SVCNAME}.pid"

depend() {
	need localmount
	# two supplicants on one radio fight over it: Patronus stops and disables iwd for an uplink
	after iwd
}

start_pre() {
	if [ "${DEV}" = "${RC_SVCNAME}" ]; then
		eerror "Use the per-device instance (patronus-wpa.<device>)"
		return 1
	fi
	[ -r "${ENVFILE}" ] || { eerror "${ENVFILE} is missing (run 'patronus apply')"; return 1; }
	. "${ENVFILE}"
	set -- ${PATRONUS_CMD}
	command="$1"
	shift
	command_args="$*"
}
