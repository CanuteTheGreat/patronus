# Configuration file for Patronus

# User and group to run Patronus as
PATRONUS_USER="patronus"
PATRONUS_GROUP="patronus"

# Web interface listen address
# Format: IP:PORT
PATRONUS_WEB_ADDR="0.0.0.0:8080"

# Additional command-line arguments for web interface
#PATRONUS_WEB_EXTRA_ARGS=""

# Configuration file location
#PATRONUS_CONFIG="/etc/patronus/patronus.toml"

# Second boot pass (patronus-services): how often `patronus apply --phase interfaces --phase routes --phase services` is tried after the
# network is up, and the pause between tries in seconds.
#PATRONUS_LATE_TRIES="5"
#PATRONUS_LATE_RETRY_DELAY="3"
