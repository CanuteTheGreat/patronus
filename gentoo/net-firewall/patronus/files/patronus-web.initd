# Copyright 2025 Gentoo Authors
# Distributed under the terms of the GNU General Public License v3

description="Patronus Web Interface"

# Same binary/port as the container image: self-signed HTTPS on :8443.
# (Used to be `/usr/bin/patronus web --addr ...:8080`, a binary that was
# never installed.) Admin password: /var/lib/patronus/initial-admin-password
# (generated on first start) or PATRONUS_ADMIN_PASSWORD in conf.d.
command="/usr/bin/patronus-web"
# nft needs these as the patronus user
capabilities="^cap_net_admin,^cap_net_raw"
command_background=true
command_user="${PATRONUS_USER:-patronus}:${PATRONUS_GROUP:-patronus}"
pidfile="/run/${RC_SVCNAME}.pid"

output_log="/var/log/patronus/web.log"
error_log="/var/log/patronus/web-error.log"

depend() {
	need net
	use dns patronus-applyd
	after firewall
}

start_pre() {
	checkpath --directory --owner ${command_user} --mode 0755 \
		/var/log/patronus \
		/var/lib/patronus
	checkpath --directory --owner ${command_user} --mode 0700 \
		/etc/patronus/tls
}
