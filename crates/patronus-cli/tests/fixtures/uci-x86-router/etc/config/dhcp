
config dnsmasq
	option domainneeded '1'
	option localise_queries '1'
	option rebind_protection '1'
	option rebind_localhost '1'
	option local '/home.example/'
	option domain 'home.example'
	option expandhosts '1'
	option cachesize '1000'
	option authoritative '1'
	option readethers '1'
	option leasefile '/tmp/dhcp.leases'
	option resolvfile '/tmp/resolv.conf.d/resolv.conf.auto'
	option localservice '0'
	option ednspacket_max '1232'
	option logqueries '1'
	list rebind_domain 'home.example'
	list rebind_domain 'corp.example'
	list rebind_domain 'internal-lb-1.elb.example.net'
	list server '/corp.example/203.0.113.53'
	list server '/corp.example/203.0.113.54'
	list server '/113.0.203.in-addr.arpa/203.0.113.53'
	list server '/10.in-addr.arpa/203.0.113.53'

config dhcp 'lan'
	option interface 'lan'
	option start '100'
	option limit '150'
	option leasetime '12h'
	option dhcpv4 'server'
	option force '1'
	option ra 'hybrid'
	option dhcpv6 'hybrid'
	option ndp 'hybrid'
	option ra_useleasetime '1'
	list ra_flags 'managed-config'
	list ra_flags 'other-config'
	list dhcp_option '6,192.168.50.3,192.168.50.4'
	list dns 'fd12:3456:789a::3'

config dhcp 'wan'
	option interface 'wan'
	option ignore '1'

config odhcpd 'odhcpd'
	option leasefile '/tmp/odhcpd.leases'
	option leasetrigger '/usr/sbin/odhcpd-update'
	option loglevel '4'

config host
	option name 'nas'
	option mac '02:00:00:00:00:21'
	option ip '192.168.50.21'
	option leasetime 'infinite'
	option dns '1'

config host
	option name 'printer'
	option mac '02:00:00:00:00:22'
	option ip '192.168.50.22'

config ipset
	list name 'lanhosts'
	list domain 'home.example'
	option table_family 'inet'

config domain
	option name 'router.home.example'
	option ip '192.168.50.1'

config domain
	option name 'dns-a'
	option ip '192.168.50.3'

config domain
	option name 'home.example'
	option ip '192.168.50.1'
