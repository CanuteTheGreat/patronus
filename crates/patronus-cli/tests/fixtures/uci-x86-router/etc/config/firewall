
config defaults
	option input 'REJECT'
	option output 'ACCEPT'
	option forward 'REJECT'
	option synflood_protect '1'

config zone
	option name 'lan'
	option input 'ACCEPT'
	option output 'ACCEPT'
	option forward 'ACCEPT'
	option masq '1'
	list network 'lan'
	list network 'vpn'

config zone
	option name 'wan'
	option input 'REJECT'
	option output 'ACCEPT'
	option forward 'REJECT'
	option masq '1'
	option mtu_fix '1'
	list network 'wan'
	list network 'wan6'
	list network 'wwan'

config forwarding
	option src 'lan'
	option dest 'wan'

config rule
	option name 'Allow-DHCP-Renew'
	option src 'wan'
	option proto 'udp'
	option dest_port '68'
	option target 'ACCEPT'
	option family 'ipv4'

config redirect
	option dest 'lan'
	option target 'DNAT'
	option name 'WireGuard'
	option proto 'udp'
	option src 'wan'
	option src_dport '51820'
	option dest_ip '192.168.50.1'
	option dest_port '51820'

config redirect
	option dest 'lan'
	option target 'DNAT'
	option name 'web_ipv6'
	option family 'ipv6'
	option src 'wan'
	option src_dport '443'
	option dest_ip '2001:db8:50::80'
	option dest_port '443'
	option enabled '0'

config rule
	option name 'ci-allow-one-port'
	option src 'lan'
	option dest 'lan'
	option src_ip '10.99.0.20'
	option dest_ip '192.168.50.60'
	option proto 'tcp'
	option dest_port '8765'
	option target 'ACCEPT'

config rule
	option name 'ci-deny-router'
	option src 'lan'
	option src_ip '10.99.0.20'
	option target 'DROP'

config include 'ipopts'
	option type 'nftables'
	option path '/etc/drop-ipopts.nft'
	option position 'ruleset-append'
