# syntax=docker/dockerfile:1
# Patronus SD-WAN Enterprise Dashboard -- container build
#
# Builds the `patronus-dashboard` crate (crates/patronus-dashboard), a
# SEPARATE product from patronus-web / the root Dockerfile: this is the
# multi-site SD-WAN enterprise dashboard used by docker-compose.ha.yml
# (dashboard1/2/3 services), not the default single-node firewall image.
#
# Unlike the root Dockerfile, patronus-dashboard is a plain Rust binary
# with no Gentoo ebuild / nftables runtime dependency -- it only needs a
# Rust toolchain to build and a thin runtime base to run, so this uses a
# conventional multi-stage cargo build rather than the emerge-based
# pattern in the root Dockerfile.
#
# The React UI (frontend/) is built in its own stage and baked into the
# image at /app/static, so `docker compose -f docker-compose.ha.yml up
# --build` is all that's needed -- no host-side Node toolchain or
# ./build-frontend.sh pre-step (that step was easy to miss and left every
# node serving "404 - Frontend not built").
#
# Rebuilds are incremental: the cargo registry and target dir live in
# BuildKit cache mounts, so after a `git pull` only changed crates
# recompile instead of the whole dependency tree (the daily QA image and
# CI rebuild this on every run).

ARG RUST_VERSION=1.90

# --- Frontend -----------------------------------------------------------
FROM node:20-bookworm-slim AS frontend
WORKDIR /usr/src/patronus/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN --mount=type=cache,id=patronus-npm,target=/root/.npm \
    npm ci --no-audit --no-fund
COPY frontend/ ./
# vite.config.ts writes to ../static (repo-root static/)
RUN npm run build && test -f ../static/index.html

# --- Builder ----------------------------------------------------------
FROM rust:${RUST_VERSION}-bookworm AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
        pkg-config \
        libssl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /usr/src/patronus

# Cargo.lock is .gitignored in this repo, so there is no lockfile to copy in
# ahead of the source for a separate dependency layer. The cache mounts
# below give the same benefit: dependencies compiled by an earlier build
# are reused from the cached target dir.
COPY . .

# Build only the patronus-dashboard binary and its path-dependency
# (patronus-sdwan), not the whole workspace. The binary is copied out of
# the cache-mounted target dir, which is not part of the image layer.
RUN --mount=type=cache,id=patronus-cargo-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=patronus-cargo-git,target=/usr/local/cargo/git \
    --mount=type=cache,id=patronus-dashboard-target,target=/usr/src/patronus/target \
    cargo build --release -p patronus-dashboard \
    && cp target/release/patronus-dashboard /usr/local/bin/patronus-dashboard

# --- Runtime ------------------------------------------------------------
FROM debian:bookworm-slim AS runtime

# docker-compose.ha.yml's healthcheck runs `curl -f http://localhost:8443/health/ready`
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        ca-certificates \
        libssl3 \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -r -u 1000 -m -s /usr/sbin/nologin patronus

COPY --from=builder /usr/local/bin/patronus-dashboard /usr/local/bin/patronus-dashboard

WORKDIR /app

# main.rs serves ./static/index.html and ./static/assets relative to WORKDIR.
COPY --from=frontend /usr/src/patronus/static /app/static

# Data dir for PATRONUS_DATA_DIR/PATRONUS_DB_PATH, owned by the runtime user.
RUN mkdir -p /data && chown -R patronus:patronus /app /data

# Read by main.rs, set per node by docker-compose.ha.yml:
#   PATRONUS_NODE_ID (enables HA; unset = standalone), PATRONUS_PEERS,
#   PATRONUS_ADVERTISE_ADDR (default <node_id>:<port>), PATRONUS_JWT_SECRET
#   (identical on every HA node; it also derives the node-to-node RPC
#   credential and the snapshot encryption key).
ENV PATRONUS_NODE_ADDR="0.0.0.0:8443" \
    PATRONUS_DATA_DIR="/data/raft" \
    PATRONUS_DB_PATH="/data/dashboard.db" \
    PATRONUS_ELECTION_TIMEOUT="5" \
    PATRONUS_HEARTBEAT_INTERVAL="1" \
    RUST_LOG="patronus_dashboard=info,tower_http=debug"

USER patronus
EXPOSE 8443

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8443/health/ready || exit 1

CMD ["patronus-dashboard"]
