[Unit]
Description=Patronus web UI
After=patronus-applyd.service
Requires=patronus-applyd.service

[Service]
EnvironmentFile=/etc/patronus/embedded.env
ExecStart=/usr/bin/patronus-web
ExecStartPost=/bin/sh -c 'echo "$(cut -d" " -f1 /proc/uptime) patronus-started" >> /tmp/boot-times'
StandardOutput=append:/var/log/web.log
StandardError=append:/var/log/web.log
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
