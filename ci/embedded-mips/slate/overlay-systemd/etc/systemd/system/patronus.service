[Unit]
Description=Patronus (apply the stored config, root broker, local web UI)
After=patronus-network.service
Wants=patronus-network.service

[Service]
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin
Type=oneshot
RemainAfterExit=yes
ExecStart=/etc/init.d/patronus start
ExecStartPost=/bin/sh -c 'echo "$(cut -d" " -f1 /proc/uptime) patronus-started" >> /tmp/boot-times'
ExecStop=/etc/init.d/patronus stop

[Install]
WantedBy=multi-user.target
