[Unit]
Description=Patronus board network (switch VLANs, br-lan, Wi-Fi client + AP)
DefaultDependencies=no
After=local-fs.target
Before=network.target
Wants=network.target

[Service]
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/patronus/board-network start
ExecStartPost=/bin/sh -c 'echo "$(cut -d" " -f1 /proc/uptime) network-up" >> /tmp/boot-times'

[Install]
WantedBy=multi-user.target
