#!/bin/sh
# /sbin/init of the systemd variant: the same early boot as the busybox image (rcS early: /dev, data volume,
# overlays, kmods, patronus-guard armed in the background), then exec systemd.
# Boot-loop stop: the OpenWrt kernel restarts 1 s after a panic (panic=1), so a systemd that dies as PID 1 would
# loop forever. Every attempt is counted on the data volume; `patronus-guard ok|auto` clears the count. From the
# third unconfirmed attempt on, the previous root (rootfs_prev, the busybox-init build) is put back.
/etc/init.d/rcS early
n=$(cat /data/.sd-boot-attempts 2>/dev/null || echo 0); n=$((n + 1)); echo $n > /data/.sd-boot-attempts; sync
echo "$(cut -d' ' -f1 /proc/uptime) systemd-attempt-$n" >> /tmp/boot-times
if [ "$n" -gt 2 ]; then
  echo "$(cut -d' ' -f1 /proc/uptime) too many unconfirmed systemd boots: rollback" >> /tmp/boot-times
  rm -f /data/.sd-boot-attempts; cp /tmp/boot-times /data/sd-rollback-boot-times 2>/dev/null
  /usr/sbin/patronus-flash rollback > /data/sd-rollback.txt 2>&1; sync; /bin/busybox reboot -f   # not /usr/sbin/reboot (= systemctl, no manager yet)
fi
echo "$(cut -d' ' -f1 /proc/uptime) exec-systemd" >> /tmp/boot-times
exec /usr/lib/systemd/systemd
# only if the exec itself failed
echo "$(cut -d' ' -f1 /proc/uptime) exec-systemd-FAILED: busybox init" >> /tmp/boot-times
exec /bin/busybox init
