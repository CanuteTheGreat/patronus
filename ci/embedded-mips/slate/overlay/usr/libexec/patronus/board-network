#!/bin/sh
# Board network (both init systems: OpenRC patronus-board, systemd patronus-network.service).
# switch VLANs (OpenWrt's: vlan1 = CPU tagged + LAN ports 2 3, vlan2 = CPU tagged + WAN port 1), br-lan, Wi-Fi client + AP
. /etc/patronus/board.sh
# 5 GHz copy of a wpa_supplicant.conf: every network pinned to the 5 GHz channels, priorities dropped. `disabled=1` is dropped too:
# it parks the networks the 2.4 GHz client must not use (the stock config's "Example Station" entry, which was disabled over a
# wrong key and is the strong, close 5 GHz AP: -26 dBm, 100+ Mbit/s, where "Other Network" is -64 dBm on 5 GHz and drops the
# client's frames). The supplicant then takes the strongest BSS; wifi-follow's health check drops one that does not carry traffic.
gen_wpa5() {
  awk -v fl="$FREQ5" '/^[ \t]*(priority|disabled)=/ {next} {print} /^[ \t]*ssid=/ {print "\tfreq_list=" fl}' "$1"
}
sw() { LD_LIBRARY_PATH=$OWLIB $OWLIB/swconfig dev switch0 "$@"; }
case "$1" in
start)
  ip link set eth0 up
  if [ -x $OWLIB/swconfig ]; then sw set reset 1; sw set enable_vlan 1; sw vlan 1 set ports "0t 2 3"; sw vlan 2 set ports "0t 1"; sw set apply 1; fi
  ip link add link eth0 name eth0.1 type vlan id 1 2>/dev/null; ip link add link eth0 name eth0.2 type vlan id 2 2>/dev/null
  ip link add br-lan type bridge 2>/dev/null; ip link set eth0.1 master br-lan; ip link set eth0.1 up; ip link set eth0.2 up; ip link set br-lan up
  # Wi-Fi: drop the kernel's default netdevs, create named ones
  for d in /sys/class/net/*; do [ -d $d/phy80211 ] && iw dev $(basename $d) del; done
  iw phy $PHY24 interface add $WAN_IF type managed && { [ -z "$STA_MAC" ] || ip link set $WAN_IF address $STA_MAC; }
  wpa_supplicant -B -i $WAN_IF -D nl80211 -c /etc/wpa_supplicant/wpa_supplicant.conf -P /run/wpa_supplicant.pid > /tmp/wpa-start.txt 2>&1 \
    || { echo "wpa_supplicant failed to start" >> /tmp/boot-times; cat /tmp/wpa-start.txt >&2; }
  # 5 GHz client (the preferred uplink): the supplicant config is the 2.4 GHz one with every network pinned to the 5 GHz
  # channels and without priorities, so the strongest known BSS wins (a `priority` would pick a weak 5 GHz channel over a strong one)
  if [ -n "$WAN5_IF" ] && [ -n "$PHY5" ]; then
    # no MAC given: the AP's with the 0x10 bit of the last octet flipped (own address, same vendor prefix)
    [ -n "$STA5_MAC" ] || [ -z "$AP5_MAC" ] || STA5_MAC="${AP5_MAC%:*}:$(printf '%02x' $(( 0x${AP5_MAC##*:} ^ 16 )))"
    iw phy $PHY5 interface add $WAN5_IF type managed && { [ -z "$STA5_MAC" ] || ip link set $WAN5_IF address $STA5_MAC; }
    gen_wpa5 /etc/wpa_supplicant/wpa_supplicant.conf > /run/wpa_supplicant-$WAN5_IF.conf && chmod 600 /run/wpa_supplicant-$WAN5_IF.conf
    wpa_supplicant -B -i $WAN5_IF -D nl80211 -c /run/wpa_supplicant-$WAN5_IF.conf -P /run/wpa_supplicant-$WAN5_IF.pid > /tmp/wpa5-start.txt 2>&1 \
      || { echo "wpa_supplicant ($WAN5_IF) failed to start" >> /tmp/boot-times; cat /tmp/wpa5-start.txt >&2; }
  fi
  # APs: created here, started by patronus-wifi-follow on the channel of the client of the same radio
  iw phy $PHY5 interface add $AP5_IF type __ap && { [ -z "$AP5_MAC" ] || ip link set $AP5_IF address $AP5_MAC; }
  [ -f /etc/hostapd/ap5.conf ] && [ -n "$AP24_IF" ] && iw phy $PHY24 interface add $AP24_IF type __ap && { [ -z "$AP24_MAC" ] || ip link set $AP24_IF address $AP24_MAC; }
  # APs outside FOLLOW (test APs) start right away
  /usr/libexec/patronus/ap start
  for i in $(seq 30); do iw dev $WAN_IF link | grep -q Connected && break; sleep 1; done
  iw dev $WAN_IF link | head -3
  ;;
esac
