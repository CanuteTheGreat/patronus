#!/bin/sh
# Apply the stored config at boot (both init systems: OpenRC patronus-apply, systemd patronus-apply.service), keep
# SSH/web reachable from the management subnet, and fall back to busybox udhcpc if Patronus' own WAN DHCP client
# has no lease after 45 s.  usage: apply [start|mgmt]
set -a; . /etc/patronus/embedded.env; set +a
. /etc/patronus/board.sh
# The management access from the upstream LAN (unit.conf MGMT_NET, over every UPLINKS interface) is a system rule in the config
# store ("Upstream management via <if>", seeded by `patronus-cli apply` from these two values: typed settings, never evaluated),
# so every firewall apply keeps it. mgmt_from_home is only the SAFETY NET for a table that has no such rule (store unreadable,
# lockdown without the rule, a table loaded by something else): it inserts the boot rule only then.
export PATRONUS_MGMT_NET="$MGMT_NET" PATRONUS_MGMT_IFACES="${UPLINKS:-$WAN_IF}"
mgmt_from_home() {
  [ -n "$MGMT_NET" ] || return 0
  nft list chain inet patronus input 2>/dev/null | grep 'Upstream management via' >/dev/null && return 0
  # every uplink client (both usually sit in the upstream LAN, each with its own address)
  ifs=; for u in ${UPLINKS:-$WAN_IF}; do ifs="${ifs:+$ifs, }\"$u\""; done
  nft list chain inet patronus input >/dev/null 2>&1 && ! nft list chain inet patronus input | grep 'patronus-boot-mgmt' >/dev/null && \
  nft insert rule inet patronus input iifname "{ $ifs }" ip saddr "$MGMT_NET" tcp dport '{ 22, 80, 443 }' accept comment '"patronus-boot-mgmt"'
}
case "${1:-start}" in
start)
  s=$(cut -d' ' -f1 /proc/uptime); patronus-cli apply > /var/log/apply.log 2>&1; echo "apply rc=$? ${s}->$(cut -d' ' -f1 /proc/uptime)" >> /var/log/apply.log
  mgmt_from_home
  setsid sh -c "sleep 45; ip -4 addr show dev $WAN_IF | grep -q inet || { logger -t patronus 'no WAN lease from patronus: udhcpc fallback'; udhcpc -b -i $WAN_IF -s /usr/share/udhcpc/default.script -p /run/udhcpc-fallback.pid; }; $0 mgmt" </dev/null >/dev/null 2>&1 &
  ;;
mgmt) mgmt_from_home ;;
esac
exit 0
