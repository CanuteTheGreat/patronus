# Environment of the Patronus services on the router tier (sourced by the OpenRC scripts and the helpers; the
# systemd units read it with EnvironmentFile=). Plain KEY=value lines only.
PATH=/usr/sbin:/usr/bin:/sbin:/bin
PATRONUS_DB=/var/lib/patronus/config.db
PATRONUS_TLS_DIR=/data/tls
PATRONUS_CONFIG=/etc/patronus/patronus.toml
PATRONUS_ANTI_LOCKOUT_PORTS=22,80,443
PATRONUS_FIRST_RUN_SETUP=1
PATRONUS_HTTPS_PORT=443
PATRONUS_HTTP_REDIRECT_PORT=80
PATRONUS_TLS_IP=10.0.66.1
PATRONUS_ARGON2_MEM_KIB=8192
# web login reads /etc/passwd+shadow in-process: musl's crypt() (what pam_unix calls here) cannot check yescrypt ($y$),
# the hash Gentoo/Horcrux hosts write, so accounts copied from them would be refused through PAM
PATRONUS_AUTH_BACKEND=shadow
PATRONUS_SYSLOG=/var/log/messages
RUST_LOG=patronus_web=info,tower_http=warn
# access log (System > Access log): a router-tier unit keeps a small history (flash and memory are scarce); the
# values are the typed settings' defaults for this tier, the store (API/UI) overrides them
PATRONUS_ACCESS_LOG_RETENTION_ROWS=2000
PATRONUS_ACCESS_LOG_RETENTION_DAYS=7
PATRONUS_ACCESS_LOG_FLUSH_MS=5000
PATRONUS_ACCESS_LOG_QUEUE=256
