# Environment of the Patronus services on the router tier (sourced by the OpenRC scripts and the helpers; the
# systemd units read it with EnvironmentFile=). Plain KEY=value lines only.
PATH=/usr/sbin:/usr/bin:/sbin:/bin
PATRONUS_DB=/var/lib/patronus/config.db
PATRONUS_TLS_DIR=/data/tls
PATRONUS_CONFIG=/etc/patronus/patronus.toml
PATRONUS_ANTI_LOCKOUT_PORTS=22,80,443
PATRONUS_FIRST_RUN_SETUP=1
PATRONUS_HTTPS_PORT=443
PATRONUS_HTTP_REDIRECT_PORT=80
PATRONUS_TLS_IP=10.0.66.1
PATRONUS_ARGON2_MEM_KIB=8192
PATRONUS_SYSLOG=/var/log/messages
RUST_LOG=patronus_web=info,tower_http=warn
