#!/bin/sh
# Patronus router tier: apply the stored config, then the root broker and the local web UI.
export PATH=/sbin:/usr/sbin:/bin:/usr/bin
export PATRONUS_DB=/var/lib/patronus/config.db PATRONUS_TLS_DIR=/data/tls PATRONUS_CONFIG=/etc/patronus/patronus.toml
export PATRONUS_ANTI_LOCKOUT_PORTS=22,80,443
export PATRONUS_FIRST_RUN_SETUP=1 PATRONUS_HTTPS_PORT=443 PATRONUS_HTTP_REDIRECT_PORT=80 PATRONUS_TLS_IP=10.0.66.1
export PATRONUS_ARGON2_MEM_KIB=8192 PATRONUS_SYSLOG=/var/log/messages
export RUST_LOG=${RUST_LOG:-patronus_web=info,tower_http=warn}
. /etc/patronus/board.sh
mgmt_from_home() { # until the store has its own WAN rule: keep SSH/web reachable from the upstream LAN (unit.conf MGMT_NET)
  [ -n "$MGMT_NET" ] || return 0
  nft list chain inet patronus input >/dev/null 2>&1 && ! nft list chain inet patronus input | grep -q 'patronus-boot-mgmt' && \
  nft insert rule inet patronus input iifname "$WAN_IF" ip saddr "$MGMT_NET" tcp dport '{ 22, 80, 443 }' accept comment '"patronus-boot-mgmt"'
}
case "$1" in
start|"")
  s=$(cut -d' ' -f1 /proc/uptime); patronus-cli apply > /var/log/apply.log 2>&1; echo "apply rc=$? ${s}->$(cut -d' ' -f1 /proc/uptime)" >> /var/log/apply.log
  mgmt_from_home
  patronus-cli applyd > /var/log/applyd.log 2>&1 &
  sleep 1
  patronus-web > /var/log/web.log 2>&1 &
  # WAN fallback: Patronus' own DHCP client should have an address by now
  ( sleep 45; ip -4 addr show dev $WAN_IF | grep -q inet || { logger -t patronus "no WAN lease from patronus: udhcpc fallback"; udhcpc -b -i $WAN_IF -s /usr/share/udhcpc/default.script -p /run/udhcpc-fallback.pid; }; mgmt_from_home ) &
  ;;
mgmt) mgmt_from_home ;;
stop) killall patronus-web patronus-cli 2>/dev/null ;;
esac
