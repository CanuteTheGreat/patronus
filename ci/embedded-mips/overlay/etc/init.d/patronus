#!/bin/sh
# Patronus router tier: apply the stored config, then the root broker and the local web UI.
export PATH=/sbin:/usr/sbin:/bin:/usr/bin
export PATRONUS_DB=/var/lib/patronus/config.db PATRONUS_TLS_DIR=/data/tls
export PATRONUS_ANTI_LOCKOUT_PORTS=22,80,443
export PATRONUS_FIRST_RUN_SETUP=1 PATRONUS_HTTPS_PORT=443 PATRONUS_HTTP_REDIRECT_PORT=80 PATRONUS_TLS_IP=192.168.1.1
export PATRONUS_ARGON2_MEM_KIB=8192   # login hashing needs 8 MiB instead of 19 MiB
export RUST_LOG=${RUST_LOG:-patronus_web=info,tower_http=warn}
case "$1" in
start|"")
  patronus-cli apply > /var/log/apply.log 2>&1
  patronus-cli applyd > /var/log/applyd.log 2>&1 &
  sleep 1
  patronus-web > /var/log/web.log 2>&1 &
  ;;
esac
