#!/bin/sh
# minimal init script (the Gentoo openrc-run one needs OpenRC, which the router tier does not ship)
PID=/run/dnsmasq.pid
alive() { [ -f $PID ] && kill -0 "$(cat $PID)" 2>/dev/null; }
case "$1" in
  start)   alive || dnsmasq --conf-file=/etc/dnsmasq.conf --pid-file=$PID ;;
  stop)    alive && kill "$(cat $PID)"; rm -f $PID ;;
  restart) $0 stop; sleep 1; $0 start ;;
  reload)  alive && kill -HUP "$(cat $PID)" ;;
  status)  alive ;;
  *) exit 2 ;;
esac
