  "private_warn": [
    "\\b(gringotts|hogshead|madammalkins|ollivanders|azkaban|rw-man-\\d+)\\b"
  ],
  "forbidden_names": [
    "\\bgnome[- ]light\\b",
    "\\blive[- ]?(installer|iso)\\b",
    "\\bforgejo\\b"
  ],
  "_note": "live pages show the machine's own addresses (interfaces, routes, uplink), so the SPA mock's private-address pattern is not used here; host names and private URLs still fail"
