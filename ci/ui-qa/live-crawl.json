{
  "product": "patronus",
  "login_path": "/login",
  "user_sel": "#username",
  "pass_sel": "#password",
  "submit_sel": "button[type=submit]",
  "username": "admin",
  "password_env": "ADMIN_PASSWORD",
  "max_routes": 90,
  "baseline": "live-crawl-baseline.json",
