#!/sbin/openrc-run
# System log: busybox syslogd on /dev/log -> /var/log/messages (tmpfs; 256 KiB + one rotated file). The web UI's log
# viewer reads it (PATRONUS_SYSLOG default). Kernel messages: patronus-klogd.
description="System log (busybox syslogd -> /var/log/messages, remote collectors of the Syslog page)"
command=/usr/libexec/patronus/syslogd
supervisor=supervise-daemon
respawn_delay=2
depend() {
	provide logger
	before patronus-board dropbear chronyd patronus-apply patronus-applyd patronus-web dnsmasq hostapd
}
