+/*
+ * Patronus: rate limit a MAC that hops between the BSSes of one radio. Each
+ * hop is a peer delete + create in the firmware; a client switching SSIDs
+ * every few seconds (two connection managers fighting over one radio) is
+ * refused on the NEW BSS for XBSS_HOLD seconds after more than XBSS_MAX hops
+ * within XBSS_WINDOW seconds, and stays where it is. Returns 1 to refuse.
+ */
+#define XBSS_SLOTS 32
+#define XBSS_MAX 6
+#define XBSS_WINDOW 60
+#define XBSS_HOLD 30
+static struct {
+	const void *iface;
+	u8 addr[ETH_ALEN];
+	struct os_reltime first;
+	struct os_reltime hold_until;
+	unsigned int hops;
+} xbss_track[XBSS_SLOTS];
+
+int ap_sta_xbss_hop_refused(struct hostapd_data *hapd, const u8 *addr)
+{
+	struct hostapd_iface *iface = hapd->iface;
+	struct os_reltime now;
+	size_t i;
+	int other = 0, slot = -1, oldest = 0;
+
+	for (i = 0; iface && i < iface->num_bss; i++) {
+		struct hostapd_data *bss = iface->bss[i];
+
+		if (bss && bss != hapd && ap_get_sta(bss, addr))
+			other = 1;
+	}
+	if (!other)
+		return 0; /* not a hop between BSSes of this radio */
+
+	os_get_reltime(&now);
+	for (i = 0; i < XBSS_SLOTS; i++) {
+		if (xbss_track[i].iface == iface &&
+		    os_memcmp(xbss_track[i].addr, addr, ETH_ALEN) == 0) {
+			slot = i;
+			break;
+		}
+		if (os_reltime_before(&xbss_track[i].first,
+				      &xbss_track[oldest].first))
+			oldest = i;
 	}
+	if (slot < 0) {
+		slot = oldest;
+		os_memset(&xbss_track[slot], 0, sizeof(xbss_track[slot]));
+		xbss_track[slot].iface = iface;
+		os_memcpy(xbss_track[slot].addr, addr, ETH_ALEN);
+		xbss_track[slot].first = now;
+	}
+	if (os_reltime_before(&now, &xbss_track[slot].hold_until)) {
+		wpa_printf(MSG_INFO, "patronus-xbss: %s: STA " MACSTR
+			   " still hopping between SSIDs: refused for now",
+			   hapd->conf->iface, MAC2STR(addr));
+		return 1;
+	}
+	if (os_reltime_expired(&now, &xbss_track[slot].first, XBSS_WINDOW)) {
+		xbss_track[slot].first = now;
+		xbss_track[slot].hops = 0;
+	}
+	if (++xbss_track[slot].hops > XBSS_MAX) {
+		xbss_track[slot].hold_until = now;
+		xbss_track[slot].hold_until.sec += XBSS_HOLD;
+		xbss_track[slot].first = now;
+		xbss_track[slot].hops = 0;
+		hostapd_logger(hapd, addr, HOSTAPD_MODULE_IEEE80211,
+			       HOSTAPD_LEVEL_NOTICE,
+			       "patronus-xbss: hopped between SSIDs more than %d times in %d s: refused on %s for %d s",
+			       XBSS_MAX, XBSS_WINDOW, hapd->conf->iface,
+			       XBSS_HOLD);
+		return 1;
+	}
+	return 0;
 }
 
 
