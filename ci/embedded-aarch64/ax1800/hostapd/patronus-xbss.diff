diff --git a/src/ap/sta_info.c b/src/ap/sta_info.c
index 13613db..9ecebc8 100644
--- a/src/ap/sta_info.c
+++ b/src/ap/sta_info.c
@@ -884,30 +884,235 @@ static int ap_sta_remove(struct hostapd_data *hapd, struct sta_info *sta)
 
 static void ap_sta_remove_in_other_bss(struct hostapd_data *hapd,
 				       struct sta_info *sta)
+{
+	ap_sta_drop_in_other_bss(hapd, sta->addr);
+}
+
+
+/*
+ * Patronus: remove a station from every OTHER BSS of this radio, from the
+ * hostapd table AND synchronously from the kernel driver, before the caller
+ * adds it to the driver on this BSS. Stock hostapd only schedules the removal
+ * (ap_sta_disconnect -> AP_MAX_INACTIVITY_AFTER_DEAUTH timer), so for up to a
+ * second the same MAC is a peer on two vdevs of one radio; the IPQ6018 ath11k
+ * firmware (WLAN.HK.2.5.0.1) asserts on that ("ar_wal_peer.c:2462 Assertion
+ * is_graceful_to_handle failed") and the SoC restarts. No frame is sent: the
+ * client has already left the old BSS. The driver removal is also issued when
+ * hostapd no longer lists the MAC there (a stale driver entry); mac80211
+ * answers ENOENT for an unknown station without calling the driver.
+ */
+void ap_sta_drop_in_other_bss(struct hostapd_data *hapd, const u8 *addr)
 {
 	struct hostapd_iface *iface = hapd->iface;
 	size_t i;
 
-	for (i = 0; i < iface->num_bss; i++) {
+	for (i = 0; iface && i < iface->num_bss; i++) {
 		struct hostapd_data *bss = iface->bss[i];
 		struct sta_info *sta2;
-		/* bss should always be set during operation, but it may be
-		 * NULL during reconfiguration. Assume the STA is not
-		 * associated to another BSS in that case to avoid NULL pointer
-		 * dereferences. */
-		if (bss == hapd || bss == NULL)
-			continue;
-		sta2 = ap_get_sta(bss, sta->addr);
-		if (!sta2)
+
+		/* bss may be NULL during reconfiguration */
+		if (bss == hapd || bss == NULL || !bss->started)
 			continue;
+		sta2 = ap_get_sta(bss, addr);
+		if (sta2) {
+			wpa_printf(MSG_INFO,
+				   "patronus-xbss: %s: STA " MACSTR
+				   " moves here from %s: removed there synchronously",
+				   hapd->conf->iface, MAC2STR(addr),
+				   bss->conf->iface);
+			hostapd_logger(bss, addr, HOSTAPD_MODULE_IEEE80211,
+				       HOSTAPD_LEVEL_INFO,
+				       "patronus-xbss: moved to %s, removed here",
+				       hapd->conf->iface);
+			hostapd_drv_sta_remove(bss, addr);
+			ap_free_sta(bss, sta2);
+		} else {
+			hostapd_drv_sta_remove(bss, addr);
+		}
+	}
+}
+
+
+/*
+ * Patronus: rate limit a MAC that hops between the BSSes of one radio. Each
+ * hop is a peer delete + create in the firmware; a client switching SSIDs
+ * every few seconds (two connection managers fighting over one radio) is
+ * refused on the NEW BSS for patronus_xbss_hold seconds after more than
+ * patronus_xbss_max hops within patronus_xbss_window seconds, and stays where
+ * it is (radio settings, patronus_xbss_max=0 = no limit). Returns 1 to refuse.
+ */
+#define XBSS_SLOTS 32
+static struct {
+	const void *iface;
+	u8 addr[ETH_ALEN];
+	struct os_reltime first;
+	struct os_reltime hold_until;
+	unsigned int hops;
+} xbss_track[XBSS_SLOTS];
 
-		wpa_printf(MSG_DEBUG, "%s: disconnect old STA " MACSTR
-			   " association from another BSS %s",
-			   hapd->conf->iface, MAC2STR(sta2->addr),
-			   bss->conf->iface);
-		ap_sta_disconnect(bss, sta2, sta2->addr,
-				  WLAN_REASON_PREV_AUTH_NOT_VALID);
+int ap_sta_xbss_hop_refused(struct hostapd_data *hapd, const u8 *addr)
+{
+	struct hostapd_iface *iface = hapd->iface;
+	struct os_reltime now;
+	size_t i;
+	int other = 0, slot = -1, oldest = 0;
+	int xmax = hapd->iconf->patronus_xbss_max;
+	int xwin = hapd->iconf->patronus_xbss_window;
+	int xhold = hapd->iconf->patronus_xbss_hold;
+
+	if (xmax <= 0)
+		return 0;
+	for (i = 0; iface && i < iface->num_bss; i++) {
+		struct hostapd_data *bss = iface->bss[i];
+
+		if (bss && bss != hapd && ap_get_sta(bss, addr))
+			other = 1;
 	}
+	if (!other)
+		return 0; /* not a hop between BSSes of this radio */
+
+	os_get_reltime(&now);
+	for (i = 0; i < XBSS_SLOTS; i++) {
+		if (xbss_track[i].iface == iface &&
+		    os_memcmp(xbss_track[i].addr, addr, ETH_ALEN) == 0) {
+			slot = i;
+			break;
+		}
+		if (os_reltime_before(&xbss_track[i].first,
+				      &xbss_track[oldest].first))
+			oldest = i;
+	}
+	if (slot < 0) {
+		slot = oldest;
+		os_memset(&xbss_track[slot], 0, sizeof(xbss_track[slot]));
+		xbss_track[slot].iface = iface;
+		os_memcpy(xbss_track[slot].addr, addr, ETH_ALEN);
+		xbss_track[slot].first = now;
+	}
+	if (os_reltime_before(&now, &xbss_track[slot].hold_until)) {
+		wpa_printf(MSG_INFO, "patronus-xbss: %s: STA " MACSTR
+			   " still hopping between SSIDs: refused for now",
+			   hapd->conf->iface, MAC2STR(addr));
+		return 1;
+	}
+	if (os_reltime_expired(&now, &xbss_track[slot].first, xwin)) {
+		xbss_track[slot].first = now;
+		xbss_track[slot].hops = 0;
+	}
+	if (++xbss_track[slot].hops > (unsigned int) xmax) {
+		xbss_track[slot].hold_until = now;
+		xbss_track[slot].hold_until.sec += xhold;
+		xbss_track[slot].first = now;
+		xbss_track[slot].hops = 0;
+		hostapd_logger(hapd, addr, HOSTAPD_MODULE_IEEE80211,
+			       HOSTAPD_LEVEL_NOTICE,
+			       "patronus-xbss: hopped between SSIDs more than %d times in %d s: refused on %s for %d s",
+			       xmax, xwin, hapd->conf->iface, xhold);
+		return 1;
+	}
+	return 0;
+}
+
+
+/*
+ * Patronus: back off from a station whose Authentication responses it never
+ * acknowledges (a device with a deaf or broken radio retrying for hours: each
+ * attempt is a response plus up to 15 retransmissions on the air, and one log
+ * line). After more than patronus_authfail_max unacknowledged responses within
+ * patronus_authfail_window seconds on any BSS of the radio, its Authentication
+ * frames are ignored (no response at all) for patronus_authfail_hold seconds;
+ * every further hold doubles, up to patronus_authfail_hold_max, until the
+ * station completes a connection (ap_sta_authfail_clear). A hold is logged
+ * once. patronus_authfail_max=0 turns it off.
+ */
+#define AUTHFAIL_SLOTS 32
+static struct {
+	const void *iface;
+	u8 addr[ETH_ALEN];
+	struct os_reltime first;
+	struct os_reltime hold_until;
+	unsigned int fails;
+	unsigned int holds;
+} authfail_track[AUTHFAIL_SLOTS];
+
+static int authfail_slot(const void *iface, const u8 *addr, int create)
+{
+	int i, oldest = 0;
+
+	for (i = 0; i < AUTHFAIL_SLOTS; i++) {
+		if (authfail_track[i].iface == iface &&
+		    os_memcmp(authfail_track[i].addr, addr, ETH_ALEN) == 0)
+			return i;
+		if (os_reltime_before(&authfail_track[i].first,
+				      &authfail_track[oldest].first))
+			oldest = i;
+	}
+	if (!create)
+		return -1;
+	os_memset(&authfail_track[oldest], 0, sizeof(authfail_track[oldest]));
+	authfail_track[oldest].iface = iface;
+	os_memcpy(authfail_track[oldest].addr, addr, ETH_ALEN);
+	os_get_reltime(&authfail_track[oldest].first);
+	return oldest;
+}
+
+void ap_sta_authfail_note(struct hostapd_data *hapd, const u8 *addr)
+{
+	struct os_reltime now;
+	int s, amax = hapd->iconf->patronus_authfail_max;
+	int awin = hapd->iconf->patronus_authfail_window;
+	int hold = hapd->iconf->patronus_authfail_hold;
+	int hmax = hapd->iconf->patronus_authfail_hold_max;
+	unsigned int k;
+
+	if (amax <= 0 || !hapd->iface)
+		return;
+	s = authfail_slot(hapd->iface, addr, 1);
+	os_get_reltime(&now);
+	if (os_reltime_expired(&now, &authfail_track[s].first, awin)) {
+		authfail_track[s].first = now;
+		authfail_track[s].fails = 0;
+	}
+	if (++authfail_track[s].fails <= (unsigned int) amax)
+		return;
+	for (k = 0; k < authfail_track[s].holds && hold < hmax; k++)
+		hold = hold * 2;
+	if (hold > hmax)
+		hold = hmax;
+	authfail_track[s].holds++;
+	authfail_track[s].fails = 0;
+	authfail_track[s].first = now;
+	authfail_track[s].hold_until = now;
+	authfail_track[s].hold_until.sec += hold;
+	hostapd_logger(hapd, addr, HOSTAPD_MODULE_IEEE80211,
+		       HOSTAPD_LEVEL_NOTICE,
+		       "patronus-authfail: more than %d authentication responses not acknowledged in %d s: ignoring it on this radio for %d s (hold %u)",
+		       amax, awin, hold, authfail_track[s].holds);
+}
+
+int ap_sta_authfail_refused(struct hostapd_data *hapd, const u8 *addr)
+{
+	struct os_reltime now;
+	int s;
+
+	if (hapd->iconf->patronus_authfail_max <= 0 || !hapd->iface)
+		return 0;
+	s = authfail_slot(hapd->iface, addr, 0);
+	if (s < 0)
+		return 0;
+	os_get_reltime(&now);
+	return os_reltime_before(&now, &authfail_track[s].hold_until);
+}
+
+void ap_sta_authfail_clear(struct hostapd_data *hapd, const u8 *addr)
+{
+	int s;
+
+	if (!hapd->iface)
+		return;
+	s = authfail_slot(hapd->iface, addr, 0);
+	if (s >= 0)
+		os_memset(&authfail_track[s], 0, sizeof(authfail_track[s]));
 }
 
 
