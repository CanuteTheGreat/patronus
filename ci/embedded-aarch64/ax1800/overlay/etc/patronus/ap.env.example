# <UNIT_DIR>/ap.env -> /etc/patronus/ap.env: this unit's Wi-Fi and LAN address (shell variables). Keep it OUT of the repo.
AP_COUNTRY=US
AP_CHAN24=1               # or "auto" (ACS)
AP_CHAN5=36               # or "auto"
AP_HT5=80                 # 20|40|80
AP_SSIDS="main iot"       # one BSS per entry and band (2.4 + 5 GHz): 2 SSIDs -> 4 BSS
SSID_main="ExampleNet"    KEY_main="<redacted:passphrase>"    SEC_main=wpa2+3   # wpa2 | wpa3 | wpa2+3
SSID_iot="ExampleIoT"     KEY_iot="<redacted:passphrase>"     SEC_iot=wpa2
#HIDE_iot=1               # hidden SSID
#ISOLATE_iot=1            # clients of this SSID cannot reach each other over the AP (ap_isolate)
# The web UI's Wi-Fi page edits this file (it keeps every line it does not manage) and restarts the radios with `ap`.
#BANDS_iot=24             # only on 2.4 GHz (default: both); 5 = only 5 GHz
AP_ADDR=                  # empty = DHCP client on br-lan; or e.g. 192.0.2.10/24 (+ AP_GW, AP_DNS)
#AP_GW=192.0.2.1  AP_DNS=192.0.2.1
# 802.11r fast transition is OFF. It triggers the ath11k firmware crash on this board's stock firmware lineage; only
# switch it on to test, never by default:
#AP_FT=1  AP_MDID=4f57
# 802.11ax (Wi-Fi 6) is ON. AP_HE=0 limits both radios to 802.11n/ac (only for clients that cannot use Wi-Fi 6):
#AP_HE=0
