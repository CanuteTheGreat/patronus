#!/bin/sh
# Early boot of the Patronus embedded tier on the GL-AX1800 (OpenWrt 25.12 6.12 kernel + Patronus musl root), shared by
# both init systems: /usr/sbin/patronus-init runs this as PID 1, then execs OpenRC (openrc-init) or systemd.
#   /dev, /tmp, /run, the data volume and the /etc, /var/lib, /root overlays on it, the factory-reset marker, OpenWrt's
#   kmods for this kernel and the ath11k calibration data.
# The data volume is the UBI volume "patronus_data", created on first boot in place of OpenWrt's rootfs_data (volumes
# kernel=0 and rootfs=1 are what the stock FIT boots). Under QEMU (CI gate, no UBI) it is the ext4 disk named by patronus.data=.
# The first-boot user and every setting live there; a staged upgrade (patronus-flash sysupgrade) is installed from here.
# Boot markers go to /tmp/boot-times (uptime seconds).
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
mark() { echo "$(cut -d' ' -f1 /proc/uptime) $*" >> /tmp/boot-times; }
mount -t proc proc /proc; mount -t sysfs sys /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null || { mount -t tmpfs -o size=512k,mode=0755 dev /dev; mdev -s; echo /sbin/mdev > /proc/sys/kernel/hotplug; }
mkdir -p /dev/pts /dev/shm; mount -t devpts devpts /dev/pts
mount -t tmpfs -o size=32m tmpfs /tmp; mount -t tmpfs -o size=16m,mode=0755 tmpfs /run; mkdir -p /var/log /var/run /run/lock
mount -t tmpfs -o size=4m tmpfs /var/log
mount -t cgroup2 cgroup2 /sys/fs/cgroup 2>/dev/null
mark early-start
hostname ax1800

# 1. persistent data
mkdir -p /data
if [ -c /dev/ubi0 ]; then
  UBI=/dev/ubi0
  # settings volume: created on first boot in place of OpenWrt's rootfs_data, with upgrade headroom (ubi-data)
  /usr/libexec/patronus/ubi-data $UBI >/dev/null 2>>/tmp/ubimkvol.log && grep -q created /tmp/ubimkvol.log 2>/dev/null && mark created-patronus_data
  # ubimkvol/ubirename's uevent needs a hotplug helper: make the node from sysfs when it is missing
  VN=$(ubinfo $UBI -N patronus_data | sed -n 's/^Volume ID: *\([0-9]*\).*/\1/p')
  [ -c ${UBI}_$VN ] || { d=$(cat /sys/class/ubi/ubi0_$VN/dev 2>/dev/null) && mknod ${UBI}_$VN c "${d%:*}" "${d#*:}"; }
  mount -t ubifs ubi0:patronus_data /data || { mark NO-DATA; mount -t tmpfs -o size=8m tmpfs /data; }
else
  DD=$(sed -n 's/.*patronus\.data=\([^ ]*\).*/\1/p' /proc/cmdline)
  { [ -n "$DD" ] && mount -t ext4 "$DD" /data; } || { mark NO-DATA; mount -t tmpfs -o size=8m tmpfs /data; }
fi
[ -f /data/.factory-reset ] && { rm -rf /data/patronus /data/tls /data/.factory-reset; mark factory-reset-done; }
# A staged upgrade (patronus-flash sysupgrade): re-verified here; when good, the early boot stops now (no overlays, no
# modules) and patronus-init hands PID 1 to upgrade-install, which writes it from a RAM root and restarts.
if [ -f /data/.upgrade/ready ]; then
  if /usr/libexec/patronus/upgrade-install verify; then mark upgrade-pending; : > /tmp/upgrade-pending; exit 0; fi
  mark upgrade-rejected
fi
for d in etc var/lib root; do n=$(echo $d | tr / -); mkdir -p /data/patronus/$n /data/patronus/.work-$n
  mount -t overlay overlay -o lowerdir=/$d,upperdir=/data/patronus/$n,workdir=/data/patronus/.work-$n /$d || mark "NO-OVERLAY $d"; done
mkdir -p /var/lib/patronus /var/lib/misc /data/tls
mark data-mounted

# The board's kmods and calibration only apply on the board itself: under the QEMU gate (armsr kernel, virtio devices,
# all drivers built in) they are skipped.
ON_BOARD=; tr '\0' '\n' < /proc/device-tree/compatible 2>/dev/null | grep -qx 'glinet,gl-ax1800' && ON_BOARD=1
[ -n "$ON_BOARD" ] || mark not-on-board
# the QEMU gate's test copy of the root carries the virt kernel's netfilter kmods instead (and this marker)
LOAD_KMODS=$ON_BOARD; [ -f /etc/patronus/qemu-kmods ] && LOAD_KMODS=1
# 2. kernel modules (OpenWrt's kmods for this exact kernel), in OpenWrt's /etc/modules.d order;
#    dependencies from modules.dep (generated at image build with depmod), loaded deepest first
KM=/lib/modules/$(uname -r)
loaded() { grep -q "^$(echo ${1%.ko} | tr - _) " /proc/modules; }
load() { # module-file [args]
  local m=$1; shift; loaded "$m" && return 0
  for d in $(sed -n "s#^${m}: ##p" $KM/modules.dep 2>/dev/null | tr ' ' '\n' | sed '1!G;h;$!d'); do loaded "$d" || insmod $KM/$d 2>>/tmp/insmod.log; done
  insmod $KM/$m "$@" 2>>/tmp/insmod.log
}
[ -n "$LOAD_KMODS" ] && for f in /etc/modules.d/*; do while read -r m args; do
  case "$m" in ''|\#*) continue;; esac; [ -f $KM/$m.ko ] && load $m.ko $args
done < "$f"; done 2>/dev/null
mark modules-loaded
ip link set lo up

# 3. ath11k: calibration data from the ART partition (+ this unit's MACs) must exist before ath11k_ahb probes, so a
#    present-but-late driver is reloaded once after the file is written (OpenWrt does the same from a firmware hotplug)
if [ -n "$ON_BOARD" ]; then /usr/libexec/patronus/ath11k-caldata >> /tmp/caldata.log 2>&1 && mark caldata-ok || mark "caldata-skipped"; fi
if [ -n "$ON_BOARD" ] && [ -d /sys/bus/platform/drivers/ath11k_ahb ] && [ -f /lib/firmware/ath11k/IPQ6018/hw1.0/cal-ahb-c000000.wifi.bin ] && [ -z "$(ls /sys/class/ieee80211 2>/dev/null)" ]; then
  rmmod ath11k_ahb 2>/dev/null; modprobe ath11k_ahb 2>/dev/null || insmod $KM/ath11k_ahb.ko 2>>/tmp/insmod.log; mark ath11k-reloaded
fi
