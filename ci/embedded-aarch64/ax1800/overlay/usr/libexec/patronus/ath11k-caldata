#!/bin/sh
# ath11k calibration data of the GL-AX1800 (port of OpenWrt's 11-ath11k-caldata + caldata.sh for this board):
#   cal-ahb-c000000.wifi.bin = 0x10000 bytes of mtd "0:art" at 0x1000, with the radio MACs patched in:
#   mac id 0 = label MAC + 3, mac id 1 = label MAC + 2 (the board's two radios), macflag set, header checksum fixed up.
# The label MAC is the one U-Boot puts into the device tree (aliases/label-mac-device). No ART partition (QEMU): exit 1.
# The output goes to a tmpfs (/run/firmware, which the early boot puts first in firmware_class.path): the root is a
# read-only squashfs. Every failure says why on stderr (the early boot logs it to /tmp/caldata.log) and exits non-zero.
# Test hooks: CALDATA_ART (file instead of the mtd char device), CALDATA_OUT, CALDATA_LABEL (MAC), CALDATA_DT.
set -e
OUT=${CALDATA_OUT:-/run/firmware/ath11k/IPQ6018/hw1.0/cal-ahb-c000000.wifi.bin}
trap 'rc=$?; [ $rc = 0 ] || echo "caldata: FAILED (exit $rc) writing $OUT" >&2' EXIT
[ -s "$OUT" ] && [ -z "$CALDATA_ART" ] && { echo "caldata: $OUT exists"; exit 0; }
ART=${CALDATA_ART:-}
if [ -z "$ART" ]; then
  i=$(sed -n 's/^mtd\([0-9]*\): [0-9a-f]* [0-9a-f]* "0:art"$/\1/p' /proc/mtd)
  [ -n "$i" ] || { echo "caldata: no 0:art partition" >&2; exit 1; }
  ART=/dev/mtd$i
fi
mkdir -p "$(dirname "$OUT")" || { echo "caldata: cannot create $(dirname "$OUT")" >&2; exit 1; }
{ true > "$OUT"; } 2>/dev/null || { echo "caldata: $OUT is not writable" >&2; exit 1; }
dd if="$ART" of="$OUT" bs=4096 skip=1 count=16 2>/dev/null || { echo "caldata: reading $ART failed" >&2; rm -f "$OUT"; exit 1; }
[ "$(wc -c < "$OUT")" = 65536 ] || { echo "caldata: short read from $ART" >&2; rm -f "$OUT"; exit 1; }
DT=${CALDATA_DT:-/proc/device-tree}
# The label MAC. This runs in the early boot BEFORE the kmods load: the Ethernet driver has not probed yet, so the
# label device's `mac-address` property (which OpenWrt's kernel only adds once the driver has read the MAC from its
# nvmem cell) does not exist yet, and `local-mac-address` is a zero placeholder. So the nvmem cell is read directly:
# the label device's nvmem-cells phandle -> the fixed-layout cell node (reg = offset) -> its partition (by label in
# /proc/mtd). An all-zero or multicast address is never used.
# Test hook: CALDATA_PARTS (directory of files named like the partition labels, instead of /dev/mtdN).
valid_mac() { case "$1" in ??:??:??:??:??:??) ;; *) return 1;; esac
  [ "$1" != 00:00:00:00:00:00 ] && [ $(( 0x${1%%:*} & 1 )) = 0 ]; }
hexmac() { od -An -tx1 | tr -s ' \n' '  ' | sed 's/^ //;s/ $//;s/ /:/g'; }
prop_mac() { [ -r "$1" ] && hexmac < "$1" | cut -c1-17; }
part_dev() { # partition label -> readable device (or test file)
  if [ -n "${CALDATA_PARTS:-}" ]; then echo "$CALDATA_PARTS/$1"; return 0; fi
  i=$(sed -n "s/^mtd\([0-9]*\): [0-9a-f]* [0-9a-f]* \"$1\"\$/\1/p" /proc/mtd); [ -n "$i" ] && echo /dev/mtd$i; }
nvmem_mac() { # device node dir -> MAC from its first nvmem cell (a fixed-layout cell inside an mtd partition)
  [ -r "$1/nvmem-cells" ] || return 1
  ph=$(od -An -tx1 -N4 "$1/nvmem-cells" | tr -d ' \n'); cell=
  for f in $(find "$DT/" -name phandle 2>/dev/null); do
    [ "$(od -An -tx1 "$f" | tr -d ' \n')" = "$ph" ] && { cell=${f%/phandle}; break; }; done
  [ -n "$cell" ] && [ -r "$cell/reg" ] || return 1
  off=$((0x$(od -An -tx1 -N4 "$cell/reg" | tr -d ' \n')))
  part=${cell%/*}; [ -r "$part/label" ] || part=${part%/*}     # cell -> nvmem-layout -> partition (or cell -> partition)
  [ -r "$part/label" ] || return 1
  d=$(part_dev "$(tr -d '\0' < "$part/label")"); [ -n "$d" ] && [ -r "$d" ] || return 1
  dd if="$d" bs=1 skip=$off count=6 2>/dev/null | hexmac; }
LABEL=${CALDATA_LABEL:-}
if [ -z "$LABEL" ]; then
  dev=$(tr -d '\0' < $DT/aliases/label-mac-device 2>/dev/null) || dev=
  if [ -n "$dev" ]; then
    for how in mac-address nvmem local-mac-address; do
      case $how in nvmem) m=$(nvmem_mac "$DT$dev") || m=;; *) m=$(prop_mac "$DT$dev/$how") || m=;; esac
      valid_mac "$m" && { LABEL=$m; echo "caldata: label MAC from $how"; break; }
    done
  fi
fi
valid_mac "$LABEL" || { echo "caldata: no valid label MAC (got '${LABEL:-none}'): calibration left unpatched (the radios keep the ART's default MACs)" >&2; exit 2; }
mac_add() { # MAC N -> MAC + N (only the NIC half, like OpenWrt's macaddr_add)
  oui=${1%:*:*:*}; nic=$(echo ${1#*:*:*:} | tr -d :)
  nic=$(printf '%06x' $(( (0x$nic + $2) & 0xffffff )))
  echo "$oui:$(echo $nic | cut -c1-2):$(echo $nic | cut -c3-4):$(echo $nic | cut -c5-6)"; }
bytes() { h=$1; while [ -n "$h" ]; do printf "\\$(printf '%03o' 0x${h%${h#??}})"; h=${h#??}; done; }   # hex -> raw bytes (octal escapes: dash/ash printf has no \x)
hex() { od -An -tx1 -v -j"$2" -N"$3" "$1" | tr -d ' \n'; }
# patch DATA(hex) at OFFSET with the 16-bit XOR checksum (at 0xa) updated
patch() {
  data=$1; off=$2; n=$((${#data} / 2)); old=$(hex "$OUT" $off $n)
  [ "$old" = "$data" ] && return 0
  c=$(hex "$OUT" 10 2); c=$((0x$c)); i=0
  while [ $i -lt $n ]; do
    o=$((0x$(echo $old | cut -c$((i*2+1))-$((i*2+4))))); w=$((0x$(echo $data | cut -c$((i*2+1))-$((i*2+4)))))
    c=$((c ^ o ^ w)); i=$((i+2)); done
  bytes "$data" | dd of="$OUT" bs=1 seek=$off conv=notrunc 2>/dev/null
  bytes "$(printf '%04x' $c)" | dd of="$OUT" bs=1 seek=10 conv=notrunc 2>/dev/null
}
m0=$(mac_add $LABEL 3 | tr -d :); m1=$(mac_add $LABEL 2 | tr -d :)
patch "$m0" $((0 * 6 + 0xe)); patch "$m1" $((1 * 6 + 0xe)); patch 0100 $((0x3e))
echo "caldata: patched $OUT (label $LABEL)"
