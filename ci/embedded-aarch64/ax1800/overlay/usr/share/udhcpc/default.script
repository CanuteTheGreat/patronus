#!/bin/sh
# busybox udhcpc script: address + default route + resolv.conf for the AP's br-lan
RESOLV=/tmp/resolv.conf.auto
# during an address trial (ap-addr) the current addresses stay up next to the new lease
keep() { for k in $(cat /run/patronus/ap-addr.keep 2>/dev/null); do ip addr add "$k" dev "$interface" 2>/dev/null; done; }
case "$1" in
bound|renew)
  ip addr flush dev "$interface" scope global 2>/dev/null
  keep
  ip addr add "$ip/${mask:-24}" ${broadcast:+broadcast $broadcast} dev "$interface"
  ip route del default dev "$interface" 2>/dev/null
  [ -n "$router" ] && for r in $router; do ip route add default via "$r" dev "$interface" metric ${metric:-10}; break; done
  : > $RESOLV; [ -n "$domain" ] && echo "search $domain" >> $RESOLV; for d in $dns; do echo "nameserver $d" >> $RESOLV; done
  echo "$(cut -d' ' -f1 /proc/uptime) lease-$ip" >> /tmp/boot-times
  ;;
deconfig) ip addr flush dev "$interface" scope global 2>/dev/null; keep ;;
esac
exit 0
