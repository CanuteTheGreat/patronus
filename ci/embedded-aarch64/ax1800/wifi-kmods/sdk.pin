# OpenWrt SDK for the exact release/kernel the GL-AX1800 image boots (stock.pin OWRT_REL, kmods.pin KMOD_URL_board).
# build-kmods.sh verifies SDK_SHA256 (from the release's sha256sums) and refuses a base feed not pinned to OWRT_TAG.
SDK_URL=https://downloads.openwrt.org/releases/25.12.6/targets/qualcommax/ipq60xx/openwrt-sdk-25.12.6-qualcommax-ipq60xx_gcc-14.3.0_musl.Linux-x86_64.tar.zst
SDK_SHA256=e33bada20e959ab95af6dbe01e79176b3716fba74da4ab73a42a8ad10e90718a
OWRT_TAG=v25.12.6
# the SDK's feeds.conf.default pins the base feed (package/kernel/mac80211) to this commit of the release
OWRT_BASE_REV=64900e756efa667774214f9c6b17c113222e01f7
KVER=6.12.112
TAG=25.12.6-aql1
