{
 "_doc": "Scope of ci/hardcode-scan.py: shipped code and image/packaging inputs. Crates outside the patronus-cli/patronus-web/installer dependency closure ship in no binary and are not scanned.",
 "include": [
  "crates/patronus-ai/src/*",
  "crates/patronus-captiveportal/src/*",
  "crates/patronus-cli/src/*",
  "crates/patronus-cni/src/*",
  "crates/patronus-config/src/*",
  "crates/patronus-core/src/*",
  "crates/patronus-ebpf/src/*",
  "crates/patronus-firewall/src/*",
  "crates/patronus-geodns/src/*",
  "crates/patronus-gitops/src/*",
  "crates/patronus-monitoring/src/*",
  "crates/patronus-mpls/src/*",
  "crates/patronus-network/src/*",
  "crates/patronus-saas/src/*",
  "crates/patronus-sdwan/src/*",
  "crates/patronus-secrets/src/*",
  "crates/patronus-web/src/*",
  "crates/patronus-web/templates/*",
  "crates/patronus-web/static/js/*",
  "crates/patronus-installer/src/*",
  "ci/embedded-*",
  "gentoo/net-firewall/*/files/*",
  "gentoo/live-iso/common/overlay/*",
  "gentoo/live-iso/common/*.py",
  "gentoo/live-iso/common/*.sh",
  "gentoo/live-iso/project/*"
 ],
 "exclude": [
  "*.md",
  "*.png",
  "*.svg",
  "*.ico",
  "*.lock",
  "*.pin",
  "*.txt",
  "*/tests/*",
  "*/testdata/*",
  "ci/embedded-*/tests/*",
  "ci/embedded-mips/t_*.py",
  "ci/embedded-mips/qemu_harness.py",
  "ci/embedded-mips/guestd.py",
  "*.diff",
  "*.patch",
  "*/qemu-gate.sh",
  "*/nandsim-proof.sh",
  "*/check-rootfs.sh",
  "*/ci-*.sh"
 ],
 "test_globs": [
  "*/tests/*",
  "*_test.rs",
  "*_tests.rs",
  "*/tests.rs",
  "*test*.py",
  "*/testing/*"
 ],
 "default_config_globs": [
  "*/etc/patronus/*.toml",
  "*/etc/patronus/*.env",
  "*/etc/patronus/board.sh",
  "*.example",
  "*.conf.example",
  "*/etc/conf.d/*",
  "*config.example.toml",
  "*/conf.d/*",
  "*.confd",
  "gentoo/*/files/*.toml",
  "crates/patronus-config/src/settings.rs"
 ],
 "build_input_globs": [
  "ci/embedded-*/*.sh",
  "ci/embedded-*/*/*.sh",
  "ci/embedded-*/*/*.py",
  "ci/embedded-*/*/hostapd/*",
  "ci/embedded-mips/*.py",
  "build/catalyst/*",
  "build/live-iso/*/build*.sh",
  "build/scripts/*",
  "*Dockerfile*",
  "*APKBUILD"
 ],
 "product_path_prefixes": [
  "/etc/patronus",
  "/var/lib/patronus",
  "/var/log/patronus",
  "/run/patronus",
  "/var/run/patronus",
  "/var/cache/patronus",
  "/usr/share/patronus",
  "/usr/libexec/patronus"
 ]
}